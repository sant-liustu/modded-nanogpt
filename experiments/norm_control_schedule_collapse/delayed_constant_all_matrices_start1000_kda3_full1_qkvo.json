{
  "enabled": true,
  "mode": "delayed_captured_constant",
  "norm_type": "rms",
  "eps": 1e-12,
  "log_every": 10,
  "start_step": 1000,
  "source": {
    "base_scope": "delayed_constant_all_matrices_start1000.json",
    "architecture": "KDA,KDA,KDA,full attention repeated three times",
    "kda_control_scope": "q_proj, k_proj, v_proj, and o_proj only; no short convolutions, forget/update/output gates, A_log, dt_bias, or 1D norm weights"
  },
  "targets": [
    { "pattern": "transformer.h.*.attn.c_q.weight" },
    { "pattern": "transformer.h.*.attn.c_k.weight" },
    { "pattern": "transformer.h.*.attn.c_v.weight" },
    { "pattern": "transformer.h.*.attn.c_proj.weight" },
    { "pattern": "transformer.h.*.attn.kda.q_proj.weight" },
    { "pattern": "transformer.h.*.attn.kda.k_proj.weight" },
    { "pattern": "transformer.h.*.attn.kda.v_proj.weight" },
    { "pattern": "transformer.h.*.attn.kda.o_proj.weight" },
    { "pattern": "transformer.h.*.mlp.c_fc.weight" },
    { "pattern": "transformer.h.*.mlp.c_proj.weight" },
    { "pattern": "transformer.wte.weight" }
  ]
}
